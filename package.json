{
  "name": "wfhub-codex",
  "version": "0.0.1",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && bun run start",
    "start": "bun dist/main.js",
    "build": "bun run clean && tsc && bun dist/main.js",
    "clean": "rimraf dist api img",
    "commit": "git add -A && oco --yes",
    "format": "turbo oxfmt oxlint",
    "oxfmt": "oxfmt --write",
    "oxlint": "oxlint --fix",
    "test": "vitest run src/test"
  },
  "dependencies": {
    "@wfcd/items": "^1.1275.40"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^0.20.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.12"
}
